{
  "chrome": {
    "manifest_version": 3,
    "name": "11tik — YouTube Thumbnail Extractor",
    "short_name": "11tik",
    "version": "1.0.0",
    "description": "Extract and download the best public YouTube thumbnail from the video you are watching. YouTube only. Client-side by 11tik.",
    "homepage_url": "https://www.11tik.com/",
    "author": "11tik",
    "icons": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "action": {
      "default_title": "11tik — Extract YouTube thumbnail",
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png"
      }
    },
    "permissions": [
      "activeTab"
    ],
    "host_permissions": [
      "https://i.ytimg.com/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "11tik-youtube-thumbnail@11tik.com",
        "strict_min_version": "140.0"
      }
    }
  },
  "firefox": {
    "manifest_version": 3,
    "name": "11tik — YouTube Thumbnail Extractor",
    "short_name": "11tik",
    "version": "1.0.0",
    "description": "Extract and download the best public YouTube thumbnail from the video you are watching. YouTube only. Client-side by 11tik.",
    "homepage_url": "https://www.11tik.com/",
    "author": "11tik",
    "icons": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "action": {
      "default_title": "11tik — Extract YouTube thumbnail",
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png"
      }
    },
    "permissions": [
      "activeTab"
    ],
    "host_permissions": [
      "https://i.ytimg.com/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "11tik-youtube-thumbnail@11tik.com",
        "strict_min_version": "140.0",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      },
      "gecko_android": {
        "strict_min_version": "142.0",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    }
  }
}